# --- 実行ユーザー設定 ---
# ホストのユーザーIDとグループIDを指定します (id -u, id -g で確認可能)
# コンテナ内のプロセスはこの権限で実行されます
PUID=1000
PGID=1000

# --- トンネル設定 (tcpexposer) ---
# https://${SUBDOMAIN}.tcpexposer.com/${DB_NAME}/ でアクセス可能になります
# tcpexposerでアカウント作成し、SSH公開鍵と希望のサブドメインを登録してください
# SSHキーのファイル名（~/.ssh 内に配置されているもの）
SSH_SECRET_KEY_FILENAME="id_ed25519"
SUBDOMAIN="your-subdomain"
TCPEXPOSER_USERNAME="your-tcpexposer-username"

# --- バックアップ設定 ---
# バックアップの間隔（秒） - デフォルト 86400 (24時間)
BACKUP_INTERVAL_SECONDS=86400
# 何日分のバックアップを保持するか（これより古いファイルは自動削除されます）
BACKUP_RETENTION_DAYS=7

# --- SQLD サーバー設定 ---
# 通常は primary のままでOKです
SQLD_NODE="primary"
